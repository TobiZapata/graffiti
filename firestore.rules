rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function roomPath(code) { return /databases/$(database)/documents/rooms/$(code); }
    function sessionPath(uid) { return /databases/$(database)/documents/roomSessions/$(uid); }
    function live(r, uid) { let c = get(sessionPath(uid)).data; return uid in r.players && !r.players[uid].left && c.uid == uid && c.roomId == r.id && c.pageId == r.players[uid].sessionId && !c.leaving && c.heartbeat > request.time - duration.value(180, 's'); }
    function claimed(r, uid) { let c = getAfter(sessionPath(uid)).data; return c.uid == uid && c.roomId == r.id && c.pageId == r.players[uid].sessionId && !c.leaving && c.heartbeat == request.time; }
    function expired(uid) { let c = get(sessionPath(uid)).data; return c.leaving || c.heartbeat <= request.time - duration.value(180, 's'); }
    function lockPath(id) { return /databases/$(database)/documents/organizationSessions/$(id); }
    function singleMatch(r) { return r.get('roomFormat','major') == 'singleMatch'; }
    function validBestOf(n) { return n is int && n in [1,3,5]; }
    function validRoomFormat(r) {
      return singleMatch(r) ? validBestOf(r.bestOf) : r.get('roomFormat','major') == 'major' && !('bestOf' in r);
    }
    function playerScores(p) {
      return !p.keys().hasAny(['awp','rifler','igl','firepower']) ||
        validScores(p);
    }
    function validScores(p) {
      let a=p.awp;
      let r=p.rifler;
      let i=p.igl;
      let f=p.firepower;
      let c=p.clutch;
      // One range expression keeps full-roster writes within the rules evaluation budget.
      return a is int && r is int && i is int && f is int && c is int &&
        [string(a),string(r),string(i),string(f),string(c)].join(',').matches('^(100|[0-9]{1,2})(,(100|[0-9]{1,2})){4}$');
    }
    function validPlayer(p) {
      let player = p.player;
      return player.name.matches('(?s)^.{1,100}$') && playerScores(player);
    }
    function validNewRoom(code, r) {
      let uid = request.auth.uid;
      return code.matches('^[A-Z0-9]{4}$') && r.keys().hasOnly(['id','name','hostId','status','visibility','playbackMode','playbackSpeed','players','schemaVersion','generation','createdAt','roomFormat','bestOf']) && validRoomFormat(r) &&
        r.get('name','Room').matches('(?s)^.{1,35}$') &&
        r.get('playbackMode','full') in ['full','highlights'] && r.get('playbackSpeed', 1) in [1, 2, 4] &&
        r.id == code && r.hostId == uid && r.schemaVersion == 3 &&
        r.status == 'lobby' && r.visibility in ['public','private'] && r.generation == 0 &&
        r.createdAt is string && r.createdAt.size() <= 40 && r.players.size() == 1 && uid in r.players &&
        member(r.players[uid],uid,true) && r.players[uid].participating && !r.players[uid].isReady && claimed(r,uid);
    }
    function validNewSession(uid, s) {
      let room = getAfter(roomPath(s.roomId)).data;
      return request.auth.uid == uid && s.keys().hasOnly(['uid','roomId','pageId','tabId','heartbeat','leaving']) &&
        s.uid == uid && s.roomId is string && s.pageId is string && s.pageId.size() > 0 && s.tabId is string && s.tabId.size() > 0 && s.heartbeat == request.time && s.leaving == false &&
        room.status == 'lobby' && uid in room.players && !room.players[uid].left && room.players[uid].sessionId == s.pageId;
    }
    function validOrganization(o) {
      return o.id.matches('^[^/]{1,150}$') &&
        o.name.matches('(?s)^.{1,100}$') && o.icon is string && o.icon.size() > 0 && o.icon.size() <= 100000 &&
        o.createdAt.matches('(?s)^.{1,100}$') &&
        o.colors is list && o.colors.size() == 2 && o.colors[0].matches('^#[0-9a-fA-F]{6}$') && o.colors[1].matches('^#[0-9a-fA-F]{6}$') &&
        o.squad is list && o.squad.size() == 5 && validPlayer(o.squad[0]) && validPlayer(o.squad[1]) && validPlayer(o.squad[2]) && validPlayer(o.squad[3]) && validPlayer(o.squad[4]) &&
        o.mainAwperUid in ['0','1','2','3','4'] && o.iglUid in ['0','1','2','3','4'] && o.starUid in ['0','1','2','3','4'];
    }
    function member(p, uid, host) {
      return p is map && p.keys().hasOnly(['uid','name','isHost','organization','participating','isReady','sessionId','left']) &&
        p.uid == uid && p.sessionId is string && p.sessionId.size() > 0 && p.left == false && p.name is string && p.name.size() <= 100 && p.isHost == host && p.participating == true && p.isReady is bool &&
        (!p.isReady || p.participating) && validOrganization(p.organization);
    }
    function memberChange(old, next, fields) {
      let change = next.diff(old);
      return change.affectedKeys().hasOnly(fields) ||
        (change.addedKeys().hasOnly(fields) && change.changedKeys().hasOnly(fields) &&
         change.removedKeys().hasOnly(fields.concat(['squad','teamName','icon'])));
    }
    function locked(r, uid) {
      let p = r.players[uid];
      let lock = getAfter(lockPath(p.organization.id));
      return p.participating && p.isReady && lock.data == { 'ownerUid': uid, 'roomId': r.id, 'tournamentId': r.tournament.tournamentId };
    }
    function startPlayer(old, next, i) {
      let keys = old.players.keys();
      return keys.size() <= i || (keys[i] in next.tournament.participantUids && locked(next, keys[i]));
    }
    function resetPlayer(players, updated, keys, ids, i) {
      let uid = keys.size() > i ? keys[i] : '';
      let p = players.get(uid, {});
      let q = updated.get(uid, {});
      return uid == '' || (p.left ? !(uid in updated) :
        q.participating == true && q.isReady == false && (!(uid in ids) || !existsAfter(lockPath(p.organization.id))) &&
        (q.diff(p).affectedKeys().hasOnly(['participating','isReady']) || memberChange(p,q,['participating','isReady'])));
    }
    function validSimulation(t) {
      let s = t.get('simulation',null);
      return s == null || (s.keys().hasOnly(['engineVersion','playerDataVersion','bankVersion']) &&
        s.engineVersion in [2,3] && s.playerDataVersion == 'players-v2.0.0' && s.bankVersion in ['mirage-economy-v1','mirage-economy-v2']);
    }
    function humanMatch(game) {
      let ids = game.playerUids;
      return ids is list && ids.size() == 2 && ids[0] != ids[1] &&
        teamAId(game) == 'player_' + ids[0] && teamBId(game) == 'player_' + ids[1];
    }
    function startSingleMatch(old, next) {
      let t = next.tournament;
      let game = t.matches[0];
      let ids = game.playerUids;
      return old.players.size() == 2 && t.participantUids.size() == 2 && t.stage == 'single_match' && t.matchesStarted == true &&
        t.matches.size() == 1 && game.id == 'single-match' && game.round == 'Single match' && game.bestOf == old.bestOf &&
        game.keys().hasOnly(['id','round','bestOf','teamAId','teamBId','playerUids','completed','result']) &&
        game.completed == false && game.result == null && humanMatch(game) &&
        ids.toSet() == t.participantUids.toSet() &&
        t.standings == [{'id': game.teamAId, 'uid': ids[0], 'name': old.players[ids[0]].organization.name},
          {'id': game.teamBId, 'uid': ids[1], 'name': old.players[ids[1]].organization.name}] &&
        startPlayer(old,next,0) && startPlayer(old,next,1);
    }
    function start(old, next) {
      return old.hostId == request.auth.uid && old.status == 'lobby' && next.status == 'playing' &&
        next.diff(old).affectedKeys().hasOnly(['status','generation','tournament']) && next.generation == old.generation + 1 &&
        validSimulation(next.tournament) && next.tournament.tournamentId is string && next.tournament.tournamentId.size() > 0 && next.tournament.tournamentId.size() <= 100 &&
        next.tournament.participantUids is list && next.tournament.participantUids.size() > 0 && next.tournament.participantUids.size() <= 8 &&
        next.tournament.participantUids.toSet().size() == next.tournament.participantUids.size() &&
        next.tournament.participantUids.toSet().difference(old.players.keys().toSet()).size() == 0 && next.tournament.get('abandonedUids',[]) == [] &&
        (singleMatch(old) ? startSingleMatch(old,next) :
          (next.tournament.matchesStarted == false && startPlayer(old,next,0) && startPlayer(old,next,1) && startPlayer(old,next,2) &&
           startPlayer(old,next,3) && startPlayer(old,next,4) && startPlayer(old,next,5) && startPlayer(old,next,6) && startPlayer(old,next,7)));
    }
    function returning(old, next) {
      let players = old.players;
      let updated = next.players;
      let keys = players.keys();
      let ids = old.tournament.participantUids;
      let last = next.lastMajor;
      return old.hostId == request.auth.uid && old.status == 'playing' && old.tournament.stage == 'won' &&
        next.diff(old).affectedKeys().hasOnly(['status','players','lastMajor']) && updated.keys().hasOnly(keys) &&
        last.keys().hasOnly(['tournamentId','winner']) && last.tournamentId == old.tournament.tournamentId &&
        resetPlayer(players,updated,keys,ids,0) && resetPlayer(players,updated,keys,ids,1) && resetPlayer(players,updated,keys,ids,2) && resetPlayer(players,updated,keys,ids,3) && resetPlayer(players,updated,keys,ids,4) && resetPlayer(players,updated,keys,ids,5) && resetPlayer(players,updated,keys,ids,6) && resetPlayer(players,updated,keys,ids,7);
    }
    function returningSingleMatch(old, next) {
      let players = old.players;
      let updated = next.players;
      let keys = players.keys();
      let t = old.tournament;
      let ids = t.participantUids;
      return request.auth.uid in ids && old.status == 'playing' && t.stage == 'won' &&
        next.diff(old).affectedKeys().hasOnly(['status','players','lastMajor']) && updated.keys().hasOnly(keys) &&
        next.lastMajor == { 'tournamentId': t.tournamentId, 'winner': t.matches[0].result.winner } &&
        resetPlayer(players,updated,keys,ids,0) && resetPlayer(players,updated,keys,ids,1);
    }
    function returnActor(r) {
      return r.hostId == request.auth.uid || (singleMatch(r) && request.auth.uid in r.tournament.participantUids && live(r,request.auth.uid));
    }
    function lobbyUpdate(old, next) {
      let uid = request.auth.uid;
      let changed = next.players.diff(old.players).affectedKeys();
      return old.status == 'lobby' && next.status == 'lobby' && (
        (uid == old.hostId && next.diff(old).affectedKeys().hasOnly(['playbackSpeed']) && next.get('playbackSpeed', 1) in [1, 2, 4]) ||
        (uid == old.hostId && singleMatch(old) && next.diff(old).affectedKeys().hasOnly(['bestOf']) && validBestOf(next.bestOf)) ||
        // A new member adds only their own entry.
        (!(uid in old.players) && next.diff(old).affectedKeys().hasOnly(['players']) && changed.hasOnly([uid]) && next.players.size() == old.players.size() + 1 && next.players.size() <= (singleMatch(old) ? 2 : 8) && member(next.players[uid],uid,false) && next.players[uid].participating && !next.players[uid].isReady) ||
        // Members may change their own readiness or validated organization.
        (uid in old.players && uid in next.players && next.diff(old).affectedKeys().hasOnly(['players']) && changed.hasOnly([uid]) &&
          (next.players[uid].diff(old.players[uid]).affectedKeys().hasOnly(['participating','isReady']) ?
            (next.players[uid].isReady is bool && next.players[uid].participating == true) :
            (memberChange(old.players[uid],next.players[uid],['organization','participating','isReady']) && member(next.players[uid],uid,uid == old.hostId))))
      );
    }
    function departedPlayer(old, next, target, i) {
      let keys = old.players.keys();
      let uid = keys.size() > i ? keys[i] : '';
      return keys.size() <= i || (uid == target ?
        (old.status == 'lobby' && target != old.hostId ? !(uid in next.players) :
         (memberChange(old.players[uid],next.players[uid],['left','isReady','isHost']) && next.players[uid].left == true && next.players[uid].isReady == false && next.players[uid].isHost == (old.status == 'lobby' && uid == old.hostId))) :
        (uid in next.players && memberChange(old.players[uid],next.players[uid],['isHost']) && next.players[uid].isHost == (uid == next.hostId)));
    }
    function leftAt(r, i) { let keys = r.players.keys(); return keys.size() <= i || r.players[keys[i]].left; }
    function departure(old, next) {
      let d = next.lastDeparture;
      let uid = d.uid;
      let forfeiting = old.status == 'playing' && old.tournament.stage != 'won' && uid in old.tournament.participantUids;
      return d is map && d.keys().hasOnly(['uid','reason']) && d.keys().hasAll(['uid','reason']) && d.reason in ['navigation','reload','closed','timeout','kicked'] &&
        uid in old.players && !old.players[uid].left && (d.reason == 'kicked' ?
          (old.status == 'lobby' && request.auth.uid == old.hostId && uid != old.hostId && live(old,request.auth.uid) &&
           get(sessionPath(uid)).data.uid == uid && get(sessionPath(uid)).data.roomId == old.id && get(sessionPath(uid)).data.pageId == old.players[uid].sessionId &&
           next.diff(old).affectedKeys().hasOnly(['players','lastDeparture'])) : (request.auth.uid == uid || expired(uid))) && !existsAfter(sessionPath(uid)) &&
        next.diff(old).affectedKeys().hasOnly(['players','hostId','status','closedReason','tournament','lastDeparture']) &&
        next.players.keys().toSet().difference(old.players.keys().toSet()).size() == 0 &&
        departedPlayer(old,next,uid,0) && departedPlayer(old,next,uid,1) && departedPlayer(old,next,uid,2) && departedPlayer(old,next,uid,3) && departedPlayer(old,next,uid,4) && departedPlayer(old,next,uid,5) && departedPlayer(old,next,uid,6) && departedPlayer(old,next,uid,7) &&
        (old.status == 'lobby' ?
          (uid == old.hostId ? next.status == 'closed' && next.closedReason == 'host-left' && next.hostId == old.hostId && next.players.size() == old.players.size() : next.status == 'lobby' && next.hostId == old.hostId && next.players.size() == old.players.size() - 1) :
          (old.status == 'playing' && next.players.size() == old.players.size() &&
           (next.status == 'closed' ? next.closedReason == 'empty' && (old.tournament.stage == 'won' ? next.tournament.stage == 'won' : next.tournament.stage == 'cancelled') && leftAt(next,0) && leftAt(next,1) && leftAt(next,2) && leftAt(next,3) && leftAt(next,4) && leftAt(next,5) && leftAt(next,6) && leftAt(next,7) : next.status == 'playing' && next.hostId in next.players && !next.players[next.hostId].left) &&
           (uid == old.hostId || next.hostId == old.hostId) && next.tournament.diff(old.tournament).affectedKeys().hasOnly(['abandonedUids','stage']) && (next.status == 'closed' || next.tournament.stage == old.tournament.stage) && next.tournament.tournamentId == old.tournament.tournamentId && next.tournament.participantUids == old.tournament.participantUids &&
           (forfeiting ? ((!existsAfter(lockPath(old.players[uid].organization.id)) || getAfter(lockPath(old.players[uid].organization.id)).data.roomId != old.id || getAfter(lockPath(old.players[uid].organization.id)).data.tournamentId != old.tournament.tournamentId) && next.tournament.get('abandonedUids',[]).toSet() == old.tournament.get('abandonedUids',[]).toSet().union([uid].toSet())) :
             next.tournament.get('abandonedUids',[]) == old.tournament.get('abandonedUids',[]))));
    }
    function validMap(m, aId, bId) {
      let a = m.scoreA;
      let b = m.scoreB;
      return m.keys().hasOnly(['map','scoreA','scoreB','winnerId']) &&
        m.map.matches('^de_(mirage|dust2|nuke|anubis|cache|inferno|ancient)$') && a is int && b is int && a >= 0 && b >= 0 &&
        (a > b ? m.winnerId == aId : b > a && m.winnerId == bId);
    }
    function teamAId(game) { return 'teamAId' in game ? game.teamAId : game.teamA.id; }
    function teamBId(game) { return 'teamBId' in game ? game.teamBId : game.teamB.id; }
    function bestOf(game) {
      return 'bestOf' in game ? game.bestOf :
        (game.round == 'Final' ? 5 : (game.round in ['Quarterfinals','Semifinals'] ||
          game.teamA.get('wins',0) == 2 || game.teamA.get('losses',0) == 2 || game.teamB.get('wins',0) == 2 || game.teamB.get('losses',0) == 2 ? 3 : 1));
    }
    function validSeries(result, aId, n, maps, count) {
      let needed = n == 5 ? 3 : (n == 3 ? 2 : 1);
      let winners = [maps[0].winnerId, count > 1 ? maps[1].winnerId : null, count > 2 ? maps[2].winnerId : null,
        count > 3 ? maps[3].winnerId : null, count > 4 ? maps[4].winnerId : null];
      let a = 5 - winners.removeAll([aId]).size();
      let b = count - a;
      let last = maps[count - 1].winnerId;
      return last == result.winner &&
        (last == aId ? a == needed && b < needed : b == needed && a < needed) &&
        (n == 1 ? (result.scoreA == maps[0].scoreA && result.scoreB == maps[0].scoreB) : (result.scoreA == a && result.scoreB == b));
    }
    // Numeric comparisons also reject other types, keeping BO5 writes within the evaluation budget.
    function validRatings(result) {
      let values = result.get('playerRatings', []);
      return !('playerRatings' in result) || (values is list && values.size() == 10 &&
        values[0] >= 0 && values[0] <= 10 && values[1] >= 0 && values[1] <= 10 && values[2] >= 0 && values[2] <= 10 && values[3] >= 0 && values[3] <= 10 && values[4] >= 0 && values[4] <= 10 &&
        values[5] >= 0 && values[5] <= 10 && values[6] >= 0 && values[6] <= 10 && values[7] >= 0 && values[7] <= 10 && values[8] >= 0 && values[8] <= 10 && values[9] >= 0 && values[9] <= 10);
    }
    function validResult(result, game, n) {
      let maps = result.maps;
      let aId = teamAId(game);
      let bId = teamBId(game);
      let count = maps.size();
      return validBestOf(n) && result.keys().hasOnly(['scoreA','scoreB','winner','maps','playerRatings']) && validRatings(result) &&
        maps is list && count >= 1 && count <= n && validMap(maps[0],aId,bId) &&
        (count < 2 || validMap(maps[1],aId,bId)) && (count < 3 || validMap(maps[2],aId,bId)) &&
        (count < 4 || validMap(maps[3],aId,bId)) && (count < 5 || validMap(maps[4],aId,bId)) &&
        validSeries(result,aId,n,maps,count) && result.scoreA is int && result.scoreB is int;
    }
    function decider(actions, m) {
      let map = m.map;
      return map in ['de_mirage','de_dust2','de_nuke','de_anubis','de_cache','de_inferno','de_ancient'] &&
        !(map in [actions[0].map,actions[1].map,actions[2].map,actions[3].map,actions[4].map,actions[5].map]);
    }
    function validSingleMap(m, teamA, teamB) {
      let a = m.scoreA;
      let b = m.scoreB;
      return m.size() == 4 && a is int && b is int &&
        (a > b ? b >= 0 && m.winnerId == teamA : b > a && a >= 0 && m.winnerId == teamB);
    }
    function validSingleResult(r, game, result) {
      let id = r.tournament.tournamentId + '~' + game.id;
      let code = r.id;
      let veto = get(/databases/$(database)/documents/rooms/$(code)/vetos/$(id)).data.veto;
      let actions = veto.actions;
      let maps = result.maps;
      let n = game.bestOf;
      let a = teamAId(game);
      let b = teamBId(game);
      let count = maps.size();
      return actions.size() == 6 && veto.bestOf == n && maps is list && count >= 1 && count <= n &&
        result.keys().hasOnly(['scoreA','scoreB','winner','maps','playerRatings']) && validRatings(result) &&
        validSingleMap(maps[0],a,b) &&
        (n == 1 ? decider(actions,maps[0]) :
          maps[0].map == actions[2].map && maps[1].map == actions[3].map && validSingleMap(maps[1],a,b) &&
          (n == 3 ? (count < 3 || (decider(actions,maps[2]) && validSingleMap(maps[2],a,b))) :
            maps[2].map == actions[4].map && validSingleMap(maps[2],a,b) &&
            (count < 4 || (maps[3].map == actions[5].map && validSingleMap(maps[3],a,b))) &&
            (count < 5 || (decider(actions,maps[4]) && validSingleMap(maps[4],a,b))))) &&
        validSeries(result,a,n,maps,count) && result.scoreA is int && result.scoreB is int;
    }
    function singleForfeit(game, result, abandoned) {
      let aWon = 'player_' + abandoned[0] == teamBId(game);
      let score = game.bestOf == 1 ? 13 : (game.bestOf == 3 ? 2 : 3);
      return result == { 'winner': aWon ? teamAId(game) : teamBId(game),
        'scoreA': aWon ? score : 0, 'scoreB': aWon ? 0 : score, 'forfeit': true, 'forfeitUids': abandoned, 'maps': [] };
    }
    function sameSingleGame(old, next) {
      return 'teamAId' in old ? next.diff(old).affectedKeys().hasOnly(['completed','result']) :
        next.keys().hasOnly(['id','round','bestOf','teamAId','teamBId','playerUids','completed','result']) &&
        next.id == old.id && next.round == old.round && next.bestOf == old.bestOf && next.playerUids == old.playerUids &&
        next.teamAId == teamAId(old) && next.teamBId == teamBId(old);
    }
    function finishSingleMatch(old, next) {
      let t = old.tournament;
      let updated = next.tournament;
      let game = t.matches[0];
      let completed = updated.matches[0];
      let abandoned = t.get('abandonedUids',[]);
      return next.diff(old).affectedKeys().hasOnly(['tournament']) && t.stage == 'single_match' && updated.stage == 'won' &&
        updated.diff(t).affectedKeys().hasOnly(['stage','matches']) && updated.matches.size() == 1 && !game.completed &&
        sameSingleGame(game,completed) && completed.completed == true &&
        request.auth.uid in game.playerUids && !(request.auth.uid in abandoned) &&
        (abandoned.size() == 0 ? validSingleResult(old,game,completed.result) :
          abandoned.size() == 1 && abandoned[0] in game.playerUids && singleForfeit(game,completed.result,abandoned));
    }
    function advanceMajor(old, next) {
      return old.hostId == request.auth.uid && next.diff(old).affectedKeys().hasOnly(['tournament']) &&
        next.tournament.tournamentId == old.tournament.tournamentId && next.tournament.participantUids == old.tournament.participantUids &&
        next.tournament.get('simulation',null) == old.tournament.get('simulation',null) &&
        next.tournament.get('abandonedUids',[]) == old.tournament.get('abandonedUids',[]);
    }
    match /rooms/{code} {
      allow get: if signed();
      allow list: if signed() && resource.data.visibility == 'public' && resource.data.status == 'lobby' && request.query.limit <= 50;
      allow create: if signed() && validNewRoom(code,request.resource.data);
      // shortcut: host controls simulation state, move advancement to a trusted server to verify every match.
      allow update: if signed() && resource.data.schemaVersion == 3 && request.resource.data.schemaVersion == 3 &&
        (((live(resource.data,request.auth.uid) || (resource.data.status == 'lobby' && !(request.auth.uid in resource.data.players) && claimed(request.resource.data,request.auth.uid))) && (resource.data.status == 'lobby' ?
          (request.resource.data.status == 'lobby' ? lobbyUpdate(resource.data,request.resource.data) : start(resource.data,request.resource.data)) :
          (request.resource.data.status == 'lobby' ? (singleMatch(resource.data) ? returningSingleMatch(resource.data,request.resource.data) : returning(resource.data,request.resource.data)) :
           (resource.data.status == 'playing' && request.resource.data.status == 'playing' &&
            (singleMatch(resource.data) ? finishSingleMatch(resource.data,request.resource.data) :
              advanceMajor(resource.data,request.resource.data)))))) || departure(resource.data,request.resource.data));
      match /chatSignals/{guestUid} {
        function room() { return get(roomPath(code)).data; }
        function active(r) { return r.status in ['lobby','playing'] && live(r,request.auth.uid); }
        function guestOffer(r, s) {
          return request.auth.uid == guestUid && guestUid != r.hostId && live(r,r.hostId) &&
            s.keys().hasOnly(['guestUid','hostUid','guestPageId','connectionId','offer','createdAt']) &&
            s.guestUid == guestUid && s.hostUid == r.hostId && s.guestPageId == r.players[guestUid].sessionId &&
            s.connectionId is string && s.connectionId.size() > 0 && s.connectionId.size() <= 100 &&
            s.offer is string && s.offer.size() > 0 && s.offer.size() <= 32000 && s.createdAt == request.time;
        }
        function hostAnswer(r, s) {
          return request.auth.uid == r.hostId && guestUid != r.hostId && live(r,guestUid) &&
            resource.data.guestUid == guestUid && resource.data.hostUid == r.hostId &&
            resource.data.guestPageId == r.players[guestUid].sessionId &&
            !('answer' in resource.data) && !('hostPageId' in resource.data) &&
            s.diff(resource.data).affectedKeys().hasOnly(['answer','hostPageId']) &&
            s.answer is string && s.answer.size() > 0 && s.answer.size() <= 32000 &&
            s.hostPageId == r.players[r.hostId].sessionId;
        }
        allow get: if signed() && active(room()) && (request.auth.uid == guestUid || request.auth.uid == room().hostId);
        allow list: if signed() && active(room()) && request.auth.uid == room().hostId && request.query.limit <= 8;
        allow create, update: if signed() && active(room()) && (guestOffer(room(),request.resource.data) || hostAnswer(room(),request.resource.data));
        allow delete: if signed() && active(room()) && (request.auth.uid == guestUid || request.auth.uid == room().hostId);
      }
      match /vetos/{vetoId} {
        function room() { return get(roomPath(code)).data; }
        function same(old, next, i) { return old.size() <= i || old[i] == next[i]; }
        function unused(actions, map, i) { return actions.size() <= i || actions[i].map != map; }
        function canWrite(r, d) {
          let t = r.tournament;
          let m = t.matches[d.matchIndex];
          return r.schemaVersion == 3 && live(r,request.auth.uid) && r.status == 'playing' && t.stage in (singleMatch(r) ? ['single_match'] : ['swiss','playoffs']) && t.matchesStarted == true &&
            d.keys().hasOnly(['tournamentId','matchId','matchIndex','veto','turnDeadlineMs']) && d.tournamentId == t.tournamentId &&
            d.matchId is string && d.matchId.size() <= 200 && vetoId == d.tournamentId + '~' + d.matchId &&
            d.matchIndex is int && d.matchIndex >= 0 && d.matchIndex < t.matches.size() && m.id == d.matchId && !m.completed &&
            humanMatch(m) && m.playerUids.toSet().difference(t.participantUids.toSet()).size() == 0 &&
            !m.playerUids.toSet().hasAny(t.get('abandonedUids',[])) && request.auth.uid in m.playerUids &&
            !exists(/databases/$(database)/documents/rooms/$(code)/results/$(vetoId)) &&
            d.veto is map && d.veto.keys().hasOnly(['version','bestOf','firstTeam','actions']) && d.veto.version == 1 &&
            d.veto.bestOf == (singleMatch(r) ? m.bestOf : bestOf(m)) &&
            d.veto.firstTeam in ['A','B'] && d.veto.actions is list && d.veto.actions.size() <= 6 &&
            (d.veto.actions.size() == 6 ? d.turnDeadlineMs == null :
              d.turnDeadlineMs is int && d.turnDeadlineMs >= request.time.toMillis() + 15000 && d.turnDeadlineMs <= request.time.toMillis() + 35000);
        }
        function nextAction(r, d) {
          let old = resource.data.veto;
          let actions = old.actions;
          let n = actions.size();
          let action = d.veto.actions[n];
          let firstTurn = old.bestOf == 1 ? n in [0,1,5] : n in [0,2,5];
          let side = firstTurn ? old.firstTeam : (old.firstTeam == 'A' ? 'B' : 'A');
          let expected = old.bestOf == 1 || n < 2 || (old.bestOf == 3 && n >= 4) ? 'ban' : 'pick';
          let m = r.tournament.matches[d.matchIndex];
          return d.diff(resource.data).affectedKeys().hasOnly(['veto','turnDeadlineMs']) && d.veto.diff(old).affectedKeys().hasOnly(['actions']) &&
            n < 6 && d.veto.actions.size() == n + 1 && same(actions,d.veto.actions,0) && same(actions,d.veto.actions,1) &&
            same(actions,d.veto.actions,2) && same(actions,d.veto.actions,3) && same(actions,d.veto.actions,4) &&
            action.keys().hasOnly(['team','action','map']) && action.team == side && action.action == expected &&
            action.map.matches('^de_(mirage|dust2|nuke|anubis|cache|inferno|ancient)$') &&
            unused(actions,action.map,0) && unused(actions,action.map,1) && unused(actions,action.map,2) && unused(actions,action.map,3) && unused(actions,action.map,4) &&
            ('player_' + request.auth.uid == (side == 'A' ? teamAId(m) : teamBId(m)) || request.time.toMillis() >= resource.data.turnDeadlineMs);
        }
        allow read: if signed() && request.auth.uid in room().players && !room().players[request.auth.uid].left;
        allow create: if signed() && canWrite(room(),request.resource.data) && request.resource.data.veto.actions.size() == 0;
        allow update: if signed() && canWrite(room(),request.resource.data) && nextAction(room(),request.resource.data);
      }
      match /results/{resultId} {
        function room() { return get(roomPath(code)).data; }
        allow read: if signed() && (request.auth.uid in room().players || room().status == 'closed' || expired(room().hostId));
        function canSubmit(r, d) {
          let t = r.tournament;
          let m = t.matches[d.matchIndex];
          return r.schemaVersion == 3 && !singleMatch(r) && live(r,request.auth.uid) && r.status == 'playing' && t.stage in ['swiss','playoffs'] && t.matchesStarted == true &&
          d.keys().hasOnly(['tournamentId','matchId','matchIndex','submittedBy','result']) &&
          d.tournamentId == t.tournamentId && d.matchId is string && d.matchId.size() <= 200 &&
          resultId == d.tournamentId + '~' + d.matchId && d.submittedBy == request.auth.uid &&
          d.matchIndex is int && d.matchIndex >= 0 && d.matchIndex < t.matches.size() &&
          m.id == d.matchId && m.completed == false && !m.playerUids.toSet().hasAny(t.get('abandonedUids',[])) && request.auth.uid in m.playerUids && request.auth.uid in r.players &&
          validResult(d.result,m,bestOf(m));
        }
        allow create: if signed() && canSubmit(room(), request.resource.data);
        allow delete: if signed() && (getAfter(roomPath(code)).data.status == 'closed' || (request.auth.uid in room().players && room().status == 'playing' && getAfter(roomPath(code)).data.status == 'lobby'));
      }
    }
    match /roomSessions/{uid} {
      allow get: if signed();
      allow list: if signed() && request.query.limit <= 8 && request.auth.uid in get(roomPath(resource.data.roomId)).data.players;
      allow create: if signed() && validNewSession(uid,request.resource.data);
      allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeat','leaving']) && request.resource.data.heartbeat == request.time && request.resource.data.leaving is bool && !resource.data.leaving && resource.data.heartbeat > request.time - duration.value(180, 's');
      allow delete: if signed() && (request.auth.uid == uid || get(roomPath(resource.data.roomId)).data.hostId == request.auth.uid || expired(uid) || get(roomPath(resource.data.roomId)).data.status == 'closed') &&
        (!existsAfter(roomPath(resource.data.roomId)) || getAfter(roomPath(resource.data.roomId)).data.status == 'closed' || !(uid in getAfter(roomPath(resource.data.roomId)).data.players) || getAfter(roomPath(resource.data.roomId)).data.players[uid].left ||
         (get(roomPath(resource.data.roomId)).data.status == 'playing' && getAfter(roomPath(resource.data.roomId)).data.status == 'lobby'));
    }
    match /users/{uid}/abandonments/{majorId} {
      allow read: if signed() && request.auth.uid == uid;
    }
    match /organizationSessions/{orgId} {
      allow get: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['ownerUid','roomId','tournamentId']) &&
        request.resource.data.roomId is string && request.resource.data.ownerUid is string && request.resource.data.tournamentId is string &&
        getAfter(roomPath(request.resource.data.roomId)).data.status == 'playing' &&
        getAfter(roomPath(request.resource.data.roomId)).data.hostId == request.auth.uid &&
        getAfter(roomPath(request.resource.data.roomId)).data.tournament.tournamentId == request.resource.data.tournamentId &&
        request.resource.data.ownerUid in getAfter(roomPath(request.resource.data.roomId)).data.tournament.participantUids &&
        getAfter(roomPath(request.resource.data.roomId)).data.players[request.resource.data.ownerUid].organization.id == orgId &&
        get(roomPath(request.resource.data.roomId)).data.status == 'lobby';
      allow delete: if signed() && get(roomPath(resource.data.roomId)).data.status == 'playing' && get(roomPath(resource.data.roomId)).data.tournament.tournamentId == resource.data.tournamentId &&
        get(roomPath(resource.data.roomId)).data.players[resource.data.ownerUid].organization.id == orgId &&
        ((getAfter(roomPath(resource.data.roomId)).data.status == 'lobby' && returnActor(get(roomPath(resource.data.roomId)).data)) ||
         (getAfter(roomPath(resource.data.roomId)).data.lastDeparture.uid == resource.data.ownerUid && getAfter(roomPath(resource.data.roomId)).data.players[resource.data.ownerUid].left &&
          (request.auth.uid == resource.data.ownerUid || expired(resource.data.ownerUid))));
    }
  }
}
